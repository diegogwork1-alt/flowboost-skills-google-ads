{
  "id": "<ID>",
  "name": "Datos diarios: Meta → hoja del cliente",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "d1",
      "name": "Cada día 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "<ID_DRIVE>",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "clientes",
          "mode": "name"
        },
        "options": {}
      },
      "id": "d2",
      "name": "Leer clientes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        200,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "<ID>",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// Clientes desde la pestaña `clientes` de la hoja maestra (la rellena el agente al dar de alta).\n// Ventana móvil de 7 días: se reescriben esos días cada mañana para que las conversiones que\n// Meta atribuye tarde queden corregidas, no solo añadidas.\nconst hoy = new Date();\nconst hasta = new Date(hoy); hasta.setDate(hoy.getDate() - 1);\nconst desde = new Date(hasta); desde.setDate(hasta.getDate() - 6);\nreturn $input.all()\n  .map(i => i.json)\n  .filter(c => c.ad_account_id && c.sheet_id && String(c.activo).toLowerCase() !== 'no')\n  .map(c => ({ json: { ...c,\n    desde: desde.toISOString().slice(0,10), hasta: hasta.toISOString().slice(0,10) } }));\n"
      },
      "id": "d3",
      "name": "Preparar ventana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "d4",
      "name": "Uno por uno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.ad_account_id }}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "level",
              "value": "campaign"
            },
            {
              "name": "fields",
              "value": "campaign_name,spend,actions,impressions,reach,inline_link_clicks,clicks"
            },
            {
              "name": "time_increment",
              "value": "1"
            },
            {
              "name": "time_range",
              "value": "={{ JSON.stringify({since:$json.desde, until:$json.hasta}) }}"
            },
            {
              "name": "limit",
              "value": "500"
            },
            {
              "name": "access_token",
              "value": "={{ $env.META_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d5",
      "name": "Meta: por día y campaña",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Una fila por DÍA y campaña, en el MISMO orden de columnas que la pestaña `datos` de la\n// hoja del cliente (ver DATOS en Estandar-carpetas/montar_hoja_reportes.py). Si cambia una,\n// cambia la otra: las fórmulas de las semanas leen por letra de columna.\n// `id` = fecha|campaña es la clave con la que se corrige en vez de duplicar.\n// `fecha` se escribe como TEXTO ISO a propósito: las fórmulas comparan texto contra texto.\nconst cli = $('Uno por uno').first().json;\nconst datos = $input.first().json.data || [];\nif (!datos.length) return [{ json: { vacio: true, cliente: cli.cliente } }];\n\nreturn datos.map(r => {\n  const gasto = parseFloat(r.spend || 0);\n  const imp   = parseInt(r.impressions || 0);\n  const alc   = parseInt(r.reach || 0);\n  const acc   = r.actions || [];\n  const busca = (...tipos) => {\n    const a = acc.find(x => tipos.includes(x.action_type));\n    return a ? parseInt(a.value) : 0;\n  };\n  const leads  = busca('lead', 'offsite_conversion.fb_pixel_lead');\n  const enlace = parseInt(r.inline_link_clicks || 0);\n  const vistas = busca('landing_page_view', 'omni_landing_page_view');\n  return { json: {\n    vacio: false,\n    id: `${r.date_start}|${r.campaign_name}`,\n    fecha: r.date_start,\n    cliente: cli.cliente,\n    campana: r.campaign_name,\n    gasto: +gasto.toFixed(2),\n    impresiones: imp,\n    alcance: alc,\n    frecuencia: alc ? +(imp / alc).toFixed(2) : 0,\n    cpm: imp ? +(gasto / imp * 1000).toFixed(2) : 0,\n    clics: parseInt(r.clicks || 0),\n    clics_enlace: enlace,\n    ctr: imp ? +(enlace / imp).toFixed(4) : 0,\n    vistas_landing: vistas,\n    leads,\n    actualizado: new Date().toISOString().slice(0,16).replace('T',' '),\n  }};\n});\n"
      },
      "id": "d6",
      "name": "Armar filas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "h1",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              },
              "leftValue": "={{ $json.vacio }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
